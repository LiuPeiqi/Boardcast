// macOS product identity has one source. Info.plist and release names use these values.
BOARDCAST_BUNDLE_IDENTIFIER = local.boardcast.mac
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
BOARDCAST_SIGNING_FLAGS =
OTHER_CODE_SIGN_FLAGS = $(inherited) $(BOARDCAST_SIGNING_FLAGS)
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
