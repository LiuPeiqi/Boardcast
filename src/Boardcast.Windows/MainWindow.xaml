<Window x:Class="Boardcast.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Boardcast · 邻间" Width="1040" Height="580" MinWidth="920" MinHeight="540" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped">
 <Grid Background="{StaticResource Paper}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="10,16,10,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button x:Name="ToggleSidebarButton" Style="{StaticResource Nav}" Click="ToggleSidebarClick" ToolTip="收起导航" AutomationProperties.Name="收起导航" Padding="12" Margin="0,0,0,12" HorizontalContentAlignment="Left">
     <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE700;" FontSize="18"/>
    </Button>
    <StackPanel Grid.Row="1">
     <Button x:Name="DevicesNav" Style="{StaticResource Nav}" Click="DevicesClick" ToolTip="发送" AutomationProperties.Name="发送">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="SendNavLabel" Text="发送" Margin="12,0,0,0"/></StackPanel>
     </Button>
     <Button x:Name="TransfersNav" Style="{StaticResource Nav}" Click="TransfersClick" ToolTip="传输记录" AutomationProperties.Name="传输记录">
      <StackPanel Orientation="Horizontal"><Grid><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="18" VerticalAlignment="Center"/><Border x:Name="PendingNavBadge" Width="7" Height="7" CornerRadius="4" Background="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed"/></Grid><TextBlock x:Name="TransfersNavLabel" Text="传输记录" Margin="12,0,0,0"/></StackPanel>
     </Button>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="SettingsClick" ToolTip="设置" AutomationProperties.Name="设置">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="SettingsNavLabel" Text="设置" Margin="12,0,0,0"/></StackPanel>
     </Button>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="6,14,6,2" Margin="0,8,0,0">
      <StackPanel>
       <StackPanel x:Name="ExpandedLocalDevice"><TextBlock Text="此设备" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="LocalName" Text="正在连接…" Margin="0,7,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
       <TextBlock x:Name="CompactLocalDevice" FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="18" HorizontalAlignment="Center" Visibility="Collapsed" ToolTip="此设备"/>
    <Button x:Name="ConnectionButton"  Click="ConnectionClick" Background="Transparent" Foreground="#21724F" BorderThickness="0" Margin="0,6,0,0" VerticalAlignment="Center" Padding="6,6" ToolTip="管理邻间的局域网连接" AutomationProperties.Name="局域网连接">
     <TextBlock x:Name="ConnectionState" Text="○  正在连接" FontSize="12"/>
    </Button>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="MainWorkspace" Grid.Column="1" Margin="20,14,20,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Visibility="Collapsed"><TextBlock x:Name="PageTitle"/><TextBlock x:Name="PageSubtitle"/></StackPanel>
   <Grid Grid.Row="1">
    <!-- Keep panel edges stable; auto tool rows and star list rows share the available viewport. -->
    <Grid x:Name="DevicesPage">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" MinWidth="365"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="280"/></Grid.ColumnDefinitions>
     <Border x:Name="SendFilesPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,12" VerticalAlignment="Stretch">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel LastChildFill="True">
        <Button x:Name="AddItemsButton" Content="添加" DockPanel.Dock="Right" Click="AddItemsClick" Style="{StaticResource SettingQuiet}" Margin="8,0,0,0" AutomationProperties.AutomationId="AddItemsButton" AutomationProperties.Name="添加文件或文件夹" Visibility="Collapsed"/>
        <Button x:Name="ClearItemsButton" Content="清空" DockPanel.Dock="Right" Style="{StaticResource SettingQuiet}" Click="ClearFilesClick" IsEnabled="False" Visibility="Collapsed" Margin="8,0,0,0" Padding="8,5"/>
        <TextBlock x:Name="FileCount" Text="0 项" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="待发送" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <Grid x:Name="FileToolsRow" Grid.Row="1" Margin="0,8,0,6" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
         <Button x:Name="ExcludeItemsButton" Content="排除…" Style="{StaticResource SettingQuiet}" Click="ExcludeClick" IsEnabled="False" AutomationProperties.AutomationId="ExcludeItemsButton"/>
         <Button x:Name="ExpandFilesButton" Content="展开清单" Style="{StaticResource Quiet}" Click="ExpandFilesClick" IsEnabled="False" Margin="0" Padding="8,5" MinHeight="32"/>
         <Button x:Name="RemoveItemsButton" Content="移除" Style="{StaticResource SettingQuiet}" IsEnabled="False" Visibility="Collapsed" AutomationProperties.AutomationId="RemoveSelectedButton" Click="RemoveFileClick" Padding="8,5"/>
        </WrapPanel>
        <DockPanel x:Name="FileSearchRow" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="筛选文件" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="FileSearch" TextChanged="FileSearchChanged" Margin="0" ToolTip="按名称或路径筛选文件与文件夹" AutomationProperties.Name="筛选待发送内容"/></DockPanel>
       </Grid>
       <Grid Grid.Row="2" MinHeight="120">
        <ListBox x:Name="FileList" SelectionMode="Extended" SelectionChanged="FileSelected" ItemTemplate="{StaticResource FileItemTemplate}" AutomationProperties.AutomationId="SelectedItems" AutomationProperties.Name="待发送内容">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="10,7"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel x:Name="EmptyFiles" VerticalAlignment="Center" Margin="16">
         <Button x:Name="EmptyFilesActionButton" Click="EmptyFilesActionClick" Style="{StaticResource Quiet}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0" Padding="8,12" AutomationProperties.AutomationId="EmptyFilesActionButton" AutomationProperties.Name="添加文件或文件夹" ToolTip="添加文件或文件夹">
          <StackPanel>
           <Border Width="64" Height="64" CornerRadius="16" Background="#F3F6FC" HorizontalAlignment="Center"><TextBlock x:Name="EmptyFilesIcon" Text="↗" FontSize="34" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <TextBlock x:Name="EmptyFilesTitle" Text="拖入文件或文件夹" Foreground="{StaticResource Ink}" FontSize="17" HorizontalAlignment="Center" Margin="0,18,0,8"/>
           <TextBlock x:Name="EmptyFilesHint" Text="也可以点击此处添加" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" FontSize="12"/>
          </StackPanel>
         </Button>
        </StackPanel>
       </Grid>
       <TextBlock Visibility="Collapsed" x:Name="FileSelectionInfo" FontSize="12"/>
       <Expander x:Name="NoteExpander" Grid.Row="3" Header="说明" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0">
        <StackPanel><TextBox x:Name="SummaryBox" AcceptsReturn="True" Height="68" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="发送给对方的说明" AutomationProperties.Name="发送说明" Margin="0,8,0,0"/><Button x:Name="SummarizeButton" Content="生成摘要" Visibility="Collapsed" Click="SummarizeClick" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
       </Expander>
      </Grid>
     </Border>
     <GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整待发送和附近设备宽度" ToolTip="拖动调整文件清单和设备区域的宽度"/>
     <Grid x:Name="DeviceArea" Grid.Column="2" VerticalAlignment="Stretch">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="PeerHeaderRow" Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="NearbyDevicesTitle" Text="附近设备" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="NoWrap"/>
       <Button x:Name="GroupFilterButton" Grid.Column="1" Click="GroupFilterClick" Style="{StaticResource SettingQuiet}" HorizontalAlignment="Stretch" Margin="0" Padding="4,5" FontSize="12" AutomationProperties.AutomationId="GroupFilterButton" AutomationProperties.Name="附近设备分组">
        <TextBlock x:Name="GroupFilterLabelText" Text="全部分组  ▾" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}" />
       </Button>
       <TextBlock x:Name="PeerCount" Grid.Column="2" Text="0 / 0 台" Foreground="{StaticResource Muted}" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
       <Button x:Name="RefreshPeersButton" Grid.Column="3" Content="刷新" Style="{StaticResource SettingQuiet}" Margin="0" Padding="4,5" Click="DiscoverClick"/>
      </Grid>
      <DockPanel x:Name="PeerSearchRow" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock Text="筛选设备" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="PeerSearch" TextChanged="PeerSearchChanged" ToolTip="按设备名、备注、地址或分组筛选" AutomationProperties.Name="筛选附近设备" Margin="0"/></DockPanel>
      <Grid Grid.Row="2">
       <ListBox x:Name="PeerList" SelectionMode="Multiple" SelectionChanged="PeerSelected" ContextMenuOpening="PeerContextOpening" PreviewMouseRightButtonDown="PeerContextMouseDown" PreviewKeyDown="PeerContextKeyDown" AutomationProperties.Name="附近设备">
        <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/><Setter Property="ToolTip" Value="{Binding Details}"/><Setter Property="Padding" Value="10,9"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Margin="0"/>
          <Path Grid.Column="1" Data="{Binding PlatformIcon}" Fill="{StaticResource Muted}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" ToolTip="{Binding PlatformLabel}" AutomationProperties.Name="{Binding PlatformLabel}"/>
          <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/>
          <TextBlock Grid.Column="3" Text="⚠" FontSize="13" Foreground="#A36C20" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Availability}" AutomationProperties.Name="{Binding Availability}">
           <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Availability}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Grid Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="100" ToolTip="{Binding Details}">
           <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding VersionLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
           <Button Content="{Binding VersionLabel}" Click="PeerUpdateClick" ToolTip="{Binding UpdateHint}" AutomationProperties.Name="{Binding UpdateHint}" FontSize="11" Foreground="{StaticResource Accent}" Background="#DCEAFF" BorderThickness="0" Padding="6,3" MinHeight="24" Margin="0">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CanOpenUpdate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
            <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></Button.ContentTemplate>
           </Button>
           <Border Background="#EDF1F6" CornerRadius="6" Padding="6,3" MinHeight="24">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding CanOpenUpdate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </Border>
          </Grid>
         </Grid>        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel x:Name="EmptyPeers" VerticalAlignment="Center" Margin="18">
        <TextBlock Text="◎" FontSize="38" Foreground="#9AABC0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptyPeersTitle" Text="等待设备上线" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,8"/>
        <TextBlock x:Name="EmptyPeersHint" Text="在同一局域网的另一台设备上打开邻间，上线后会自动出现。" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
        <Button x:Name="ShowAllPeersButton" Content="显示全部设备" Click="ShowAllPeersClick" Style="{StaticResource SettingButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="ShowAllPeersButton"/>
       </StackPanel>
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
       <WrapPanel x:Name="DeviceActions">
        <WrapPanel.Resources><Style x:Key="DeviceAction" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,0,6,0"/></Style></WrapPanel.Resources>
        <Button x:Name="ConnectPeerButton" Content="通过 IP 连接" Style="{StaticResource DeviceAction}" Click="ConnectClick"/>
        <Button x:Name="ManagePeerButton" Content="设备详情" Style="{StaticResource DeviceAction}" IsEnabled="False" Click="ManagePeerClick"/>
        <Button x:Name="ReceiveFolderButton" Content="打开接收文件夹" Style="{StaticResource DeviceAction}" Click="ReceiveFolderClick" Margin="0"/>
        <Button x:Name="ShareSubnetsButton" Content="分享网段" Style="{StaticResource DeviceAction}" Click="ShareSubnetsClick" IsEnabled="False" AutomationProperties.AutomationId="ShareSubnetsButton"/>
       </WrapPanel>
       <DockPanel Margin="8,8,0,0"><Button x:Name="ClearPeersButton" DockPanel.Dock="Right" Content="清除选择" Click="ClearPeersClick" Style="{StaticResource Quiet}" Padding="5,2" MinHeight="0" FontSize="12" Visibility="Collapsed" Margin="8,0,0,0"/><TextBlock x:Name="RecipientHint" Text="点击设备可多选" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="RecipientNames" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="SendButton" Grid.Row="4" Content="选择设备后发送" Style="{StaticResource Primary}" Click="SendClick" IsEnabled="False" Margin="0,12,0,0" Padding="12,10"/>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="TransfersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TransferContent"/></ScrollViewer>
    <Grid x:Name="SettingsHost" Visibility="Collapsed" MaxWidth="820">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,16"><WrapPanel>
      <Button x:Name="GeneralSettingsTab" Content="常规" Tag="general" Click="SettingsSectionClick" Style="{StaticResource SettingTab}" BorderBrush="Transparent"/>
      <Button x:Name="RulesSettingsTab" Content="接收规则" Tag="rules" Click="SettingsSectionClick" Style="{StaticResource SettingTab}" BorderBrush="Transparent"/>
      <Button x:Name="DevicesSettingsTab" Content="设备与信任" Tag="known" Click="SettingsSectionClick" Style="{StaticResource SettingTab}" BorderBrush="Transparent"/>
      <Button x:Name="ExtensionsSettingsTab" Content="扩展" Tag="extensions" Click="SettingsSectionClick" Style="{StaticResource SettingTab}" BorderBrush="Transparent"/>
      <Button x:Name="UpdatesSettingsTab" Content="关于与更新" Tag="updates" Click="SettingsSectionClick" Style="{StaticResource SettingTab}" BorderBrush="Transparent"/>
            </WrapPanel></Border>
     <ScrollViewer x:Name="RulesPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RuleContent" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,4,0"/></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsContent" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,4,0"/></ScrollViewer>
    </Grid>
   </Grid>
   <!-- Transient feedback shares the content layer and never reserves a footer row. -->
   <Grid Grid.Row="1" Panel.ZIndex="10" IsHitTestVisible="False">
    <Border x:Name="StatusNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,116" MaxWidth="680" Padding="12,8" Background="#F7FFFFFF" BorderBrush="#C8D6EC" BorderThickness="1" CornerRadius="6">
     <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Window>
