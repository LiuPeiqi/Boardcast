<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <Reference Include="Boardcast.Core"><HintPath>$(ReleaseCorePath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireReleasedCore" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ReleaseCorePath)' == '' Or !Exists('$(ReleaseCorePath)')" Text="Pass -p:ReleaseCorePath pointing to the selected released Core DLL." />
  </Target>
</Project>
